# Copie este arquivo para ".env" (na mesma pasta do script) e preencha com
# suas chaves de API. NUNCA faça commit do arquivo ".env" (com chaves reais)
# em um repositorio publico - ele ja esta listado no .gitignore deste projeto.

# Groq (gratuito, 14400 req/dia) — recomendado para --C 15 --N 3
# Gere em: https://console.groq.com/keys
GROQ_API_KEY=sua-chave-groq-aqui

# OpenRouter (gratuito, ~200 req/dia por modelo)
# Gere em: https://openrouter.ai/keys
OPENROUTER_API_KEY=sua-chave-openrouter-aqui

# Google Gemini (limite diario de 20 req/dia — pode nao ser suficiente)
# Gere em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua-chave-gemini-aqui
