# Copie este arquivo para ".env" (na mesma pasta do script) e preencha com
# a sua chave de API do Google Gemini. Voce pode gerar uma chave em:
#   https://aistudio.google.com/app/apikey
#
# NUNCA faça commit do arquivo ".env" (com a chave real) em um repositorio
# publico - ele ja esta listado no .gitignore deste projeto.

GEMINI_API_KEY=sua-chave-aqui
